{
  "datasets": [
    {
      "name": "5e40ade1",
      "displayName": "kpis_gerais",
      "queryLines": [
        "SELECT\r\n",
        "  ROUND(SUM(CASE WHEN is_valid_sale THEN items_value END), 2)                       AS gmv,\r\n",
        "  COUNT_IF(is_valid_sale)                                                           AS pedidos_validos,\r\n",
        "  ROUND(SUM(CASE WHEN is_valid_sale THEN items_value END)\r\n",
        "        / COUNT_IF(is_valid_sale), 2)                                               AS ticket_medio,\r\n",
        "  ROUND(COUNT_IF(is_late) / COUNT_IF(is_late IS NOT NULL), 4)                       AS taxa_atraso,\r\n",
        "  ROUND(COUNT_IF(order_status = 'canceled') / COUNT(*), 4)                          AS taxa_cancelamento,\r\n",
        "  ROUND(AVG(review_score), 2)                                                       AS nota_media\r\n",
        "FROM workspace.varejo.gold_fact_orders"
      ]
    },
    {
      "name": "995fd83e",
      "displayName": "vendas_mensais",
      "queryLines": [
        "SELECT\r\n",
        "  DATE_TRUNC('month', purchase_date)        AS mes,\r\n",
        "  ROUND(SUM(gmv), 2)                        AS gmv,\r\n",
        "  SUM(valid_orders)                         AS pedidos_validos,\r\n",
        "  ROUND(SUM(gmv) / SUM(valid_orders), 2)    AS ticket_medio\r\n",
        "FROM workspace.varejo.gold_daily_sales\r\n",
        "WHERE purchase_date >= '2017-01-01' AND purchase_date < '2018-09-01'\r\n",
        "GROUP BY DATE_TRUNC('month', purchase_date)\r\n",
        "ORDER BY mes;"
      ]
    },
    {
      "name": "8900d952",
      "displayName": "volume_diario_anomalias",
      "queryLines": [
        "SELECT\r\n",
        "  purchase_date,\r\n",
        "  orders                          AS pedidos,\r\n",
        "  ROUND(orders_mean, 1)           AS media_28d,\r\n",
        "  orders_z                        AS z_score,\r\n",
        "  is_anomaly,\r\n",
        "  CASE WHEN is_anomaly THEN orders END AS pedidos_anomalos\r\n",
        "FROM workspace.varejo.gold_volume_anomalies\r\n",
        "ORDER BY purchase_date;"
      ]
    },
    {
      "name": "b135f3b4",
      "displayName": "sla_por_estado",
      "queryLines": [
        "SELECT\r\n",
        "  customer_state                                                      AS estado,\r\n",
        "  SUM(delivered_orders)                                               AS entregas,\r\n",
        "  ROUND(SUM(late_orders) / SUM(delivered_orders), 4)                  AS taxa_atraso,\r\n",
        "  ROUND(SUM(avg_delivery_days * delivered_orders)\r\n",
        "        / SUM(delivered_orders), 1)                                   AS prazo_medio_dias\r\n",
        "FROM workspace.varejo.gold_delivery_sla\r\n",
        "GROUP BY customer_state\r\n",
        "HAVING SUM(delivered_orders) >= 500\r\n",
        "ORDER BY taxa_atraso DESC;"
      ]
    },
    {
      "name": "6b19f085",
      "displayName": "top_categorias",
      "queryLines": [
        "SELECT\r\n",
        "  category                       AS categoria,\r\n",
        "  ROUND(gmv, 2)                  AS gmv,\r\n",
        "  orders                         AS pedidos,\r\n",
        "  avg_review                     AS nota_media,\r\n",
        "  ROUND(low_score_rate * 100, 1) AS pct_notas_baixas\r\n",
        "FROM workspace.varejo.gold_category_satisfaction\r\n",
        "ORDER BY gmv DESC\r\n",
        "LIMIT 15;"
      ]
    },
    {
      "name": "3e8ee1ef",
      "displayName": "concentracao_vendedores",
      "queryLines": [
        "SELECT\r\n",
        "  gmv_rank                                   AS ranking_vendedor,\r\n",
        "  ROUND(gmv_cumulative_share * 100, 1)       AS pct_gmv_acumulado\r\n",
        "FROM workspace.varejo.gold_seller_performance\r\n",
        "WHERE gmv_rank = 1 OR gmv_rank % 25 = 0\r\n",
        "ORDER BY gmv_rank;"
      ]
    },
    {
      "name": "9f0a9715",
      "displayName": "qualidade_ultima_execucao",
      "queryLines": [
        "SELECT\r\n",
        "  check_id, check_name, severity, total_records, failed_records,\r\n",
        "  ROUND(failure_rate * 100, 3) AS pct_falha,\r\n",
        "  ROUND(threshold * 100, 3)    AS pct_limite,\r\n",
        "  status\r\n",
        "FROM workspace.varejo.quality_results\r\n",
        "WHERE run_id = (SELECT run_id FROM workspace.varejo.quality_results ORDER BY run_ts DESC LIMIT 1)\r\n",
        "ORDER BY status ASC, severity, check_id;"
      ]
    },
    {
      "name": "136c5c56",
      "displayName": "alertas_recentes",
      "queryLines": [
        "SELECT created_ts, as_of_date, alert_type, severity, title, sent\r\n",
        "FROM workspace.varejo.alerts_log\r\n",
        "ORDER BY created_ts DESC\r\n",
        "LIMIT 20;\r\n"
      ]
    }
  ],
